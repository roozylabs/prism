# ==========================================
# AI Gateway Production Environment Template
# Place this file as `.env` in root VPS folder
# ==========================================

# Domain & SSL Configuration
DOMAIN=roozylabs.com
ACME_EMAIL=admin@roozylabs.com

# General Application Environment
APP_ENV=production
SERVER_PORT=8080
APP_PORT=3000

# Database Migration Control
# Runtime API containers (api, api-green) start without touching DDL.
# Use the dedicated one-shot `migrator` service (./server --migrate-only) to apply migrations.
RUN_MIGRATIONS=false

# PostgreSQL Database Configuration
POSTGRES_DB=ai_gateway
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5433

# Redis Cache Configuration
REDIS_PASSWORD=redis
REDIS_PORT=6379

# Go API Gateway Security Keys
# Required outside APP_ENV=development: at least 32 characters, e.g. `openssl rand -hex 32`.
# The API refuses to start with an empty, weak, or previously published key.
ENCRYPTION_KEY=

# Better Auth Configuration
BETTER_AUTH_SECRET=your-better-auth-secret-here
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# Next.js Server Proxy Target (Internal Docker Network)
API_URL=http://api:8080

# CORS Whitelist Origins (comma-separated)
ALLOWED_ORIGINS=https://app.prism.roozylabs.com,https://prism.roozylabs.com,https://api.prism.roozylabs.com,http://localhost:3000

# Member invitations. Links point at the dashboard's public address. With
# SMTP_HOST and SMTP_FROM set the link is emailed to the invitee; otherwise it
# is shown once to the inviter to pass on.
APP_PUBLIC_URL=https://app.prism.roozylabs.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=Prism <noreply@example.com>

# Observability. /metrics answers 404 in production until METRICS_TOKEN is set;
# Prometheus sends it as a bearer token (deploy/otel/prometheus.yml).
# Generate with `openssl rand -hex 24`. Logs are JSON (LOG_FORMAT=text for a
# human-readable stream). OTLP export of traces and metrics is off unless
# OTEL_ENABLED=true; the Prometheus endpoint works without it.
# METRICS_TOKEN=
# LOG_FORMAT=json
# OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_SERVICE_NAME=prism-gateway
# OTEL_SAMPLING_RATE=1.0

# Go runtime memory target for the API containers; keep it at ~75% of the
# container's memory limit (1 GiB in docker-compose.yml).
# GOMEMLIMIT=768MiB

# Data retention (days; 0 keeps forever). The API deletes older rows hourly in
# batches. Prompt text lives in request payloads and routing decisions.
# RETENTION_REQUEST_LOGS_DAYS=180
# RETENTION_ROUTING_DECISIONS_DAYS=30
# RETENTION_REQUEST_PAYLOADS_DAYS=30
# RETENTION_TOOL_INVOCATIONS_DAYS=30
# RETENTION_MCP_INVOCATIONS_DAYS=30
# RETENTION_AI_AUDIT_TRAILS_DAYS=365
# RETENTION_AUDIT_LOGS_DAYS=365
# RETENTION_COST_ANOMALIES_DAYS=180
# RETENTION_BUDGET_ALERTS_DAYS=180
